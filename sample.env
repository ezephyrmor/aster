# ------------------------------------------------------------------------------
# ASTER HR SYSTEM - SAMPLE ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values for your environment
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Database (Docker / PostgreSQL 16)
# Start the local container with:  docker compose up -d   (see docker-compose.yml)
# Keep these credentials in sync with DATABASE_URL below.
# ------------------------------------------------------------------------------
POSTGRES_DB=aster
POSTGRES_USER=aster
POSTGRES_PASSWORD=aster
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection string for PostgreSQL
# Local Docker: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL="postgresql://aster:aster@localhost:5432/aster"
# For Neon/Supabase on Vercel, use the marketplace connection string
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:password@host/db?sslmode=require"  # Required for Neon migrations

# NextAuth secret (for session management)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="aster-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Password pepper (secret value for password hashing)
# This should be a random string and kept secret - never commit to version control
# Generate with: openssl rand -base64 32
PASSWORD_PEPPER=change-this-to-a-random-secret-in-production

# Demo mode - set to "true" to enable demo mode (no database required)
# DEMO_MODE=true

AUTHJS_LOGGER_LEVEL=silent

# ------------------------------------------------------------------------------
# AI provider keys (server-side only — never exposed to the client)
# Used by the AI sticker generator. Leave blank to disable AI.
# Set AI_PROVIDER to pick the default provider (openai | stability | google |
# openrouter | huggingface | mock). "mock" needs no key and renders a
# placeholder image.
#
# FREE SETUP (recommended):
#   1. HUGGINGFACE_API_KEY — free token from huggingface.co → Settings →
#      Access Tokens. Create a FINE-GRAINED token and enable the
#      "Make calls to Inference Providers" permission (required).
#   2. GOOGLE_API_KEY — free key from aistudio.google.com (Imagen 3 daily
#      free quota). Acts as automatic backup: generation falls back
#      huggingface → google when a provider fails or rate-limits.
# ------------------------------------------------------------------------------
# AI_PROVIDER=openrouter
#
# Provider API keys — only the key for your chosen provider is required:
# OPENAI_API_KEY="sk-your-openai-key-here"
# STABILITY_API_KEY="sk-your-stability-key-here"
# GOOGLE_API_KEY="your-google-api-key-here"
# OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"
# HUGGINGFACE_API_KEY="hf_your-huggingface-token-here"
#
# Optional: override the model id used by the OpenRouter worker (AI_MODEL) or the
# Hugging Face text-to-image model (HUGGINGFACE_MODEL, falling back to AI_MODEL,
# then FLUX.1-schnell). Must match an id in the per-provider catalog
# (src/lib/ai/models.ts):
# AI_MODEL="google/gemini-2.5-flash-image"
# HUGGINGFACE_MODEL="black-forest-labs/FLUX.1-schnell"
#
# Notes:
#  - OpenAI, Google/Imagen and OpenRouter have no native negative prompt; the
#    restrictions are injected into the prompt text. Stability and Hugging Face
#    send a native negative_prompt.
#  - When a pack asks for transparency, OpenRouter also requests a transparent
#    PNG (output_format + background); the cutout pipeline is a further safeguard.