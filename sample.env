# ------------------------------------------------------------------------------
# ASTER HR SYSTEM - SAMPLE ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values for your environment
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Database (Docker / PostgreSQL 16)
# Start the local container with:  docker compose up -d   (see docker-compose.yml)
# Keep these credentials in sync with DATABASE_URL below.
# ------------------------------------------------------------------------------
POSTGRES_DB=aster
POSTGRES_USER=aster
POSTGRES_PASSWORD=aster
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection string for PostgreSQL
# Local Docker: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL="postgresql://aster:aster@localhost:5432/aster"
# For Neon/Supabase on Vercel, use the marketplace connection string
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:password@host/db?sslmode=require"  # Required for Neon migrations

# NextAuth secret (for session management)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="aster-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Password pepper (secret value for password hashing)
# This should be a random string and kept secret - never commit to version control
# Generate with: openssl rand -base64 32
PASSWORD_PEPPER=change-this-to-a-random-secret-in-production

# Demo mode - set to "true" to enable demo mode (no database required)
# DEMO_MODE=true

AUTHJS_LOGGER_LEVEL=silent

# ------------------------------------------------------------------------------
# AI provider keys (server-side only — never exposed to the client)
# Used by ai-feature skill / AI sticker generator. Leave blank to disable AI.
# ------------------------------------------------------------------------------
# OPENAI_API_KEY="sk-your-openai-key-here"
# AI_MODE=mock        # "mock" fakes provider calls in dev (no real key needed)